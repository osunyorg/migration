<% content_for :title, "Languages" %>

<%= link_to t('actions.create'), new_website_language_path, class: "btn btn-primary mb-3" %>

<% if @languages.any? %>
  <table class="table" id="languages">
    <thead>
      <tr>
        <th><%= Website::Language.human_attribute_name(:name) %></th>
        <th><%= Website::Language.human_attribute_name(:iso_code) %></th>
      </tr>
    </thead>
    <tbody>
      <% @languages.each do |language| %>
        <tr>
          <td><%= link_to language, language %></td>
          <td><%= language.iso_code %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
