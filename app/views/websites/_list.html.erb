<div clas="row">
  <% websites.each do |website| %>
    <div class="col-lg-3 col-md-4 mb-2">
      <div class="card">
        <div class="card-body">
          <h2 class="h4"><%= link_to website, website, class: 'text-decoration-none stretched-link' %></h2>
          <p class="text-muted"><%= website.url %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>
