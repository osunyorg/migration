<table class="table table-hover">
  <% websites.each do |website| %>
    <tr class="position-relative">
      <td><%= link_to website, website, class: 'stretched-link text-decoration-none' %></td>
      <td class="text-muted"><%= website.url %></td>
      <td class="text-muted"><%= website.pages.count %> <%= Website::Page.model_name.human(count: 2).downcase %></td>
    </tr>
  <% end %>
</table>