<% content_for :title, @group %>

<h1><%= @group %></h1>

<div class="mb-4">
  <%= link_to "Edit", [:edit, @group], class: "btn btn-primary" %>
  <%= link_to "Destroy", @group, method: :delete, class: "btn btn-danger", data: { confirm: "Are you sure?" } %>
</div>

<h2>Root pages (<%= @root_pages.size %>)</h2>
<p>Total: <%= @group.pages.size %></p>
<%= link_to "Select Pages", select_pages_website_group_path(@group, website_id: @website.id), class: "btn btn-primary mb-3" %>

<%= render "websites/pages/list", pages: @root_pages if @root_pages.any? %>
