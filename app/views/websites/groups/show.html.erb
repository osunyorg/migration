<% content_for :title, @group %>

<p>
  <strong><%= Website::Group.human_attribute_name(:strategy) %></strong>
  <%= @group.strategy.to_s %>
</p>

<div class="mb-4">
  <%= link_to t('actions.migrate'), [:migrate, @group], class: "btn btn-primary" if @group.strategy %>
  <%= link_to t('actions.edit'), [:edit, @group], class: "btn btn-primary" %>
  <%= link_to t('actions.delete'), @group, method: :delete, class: "btn btn-danger", data: { confirm: "Are you sure?" } %>
</div>

<h2><%= Website::Page.model_name.human(count: 2) %></h2>
<p><%= @group.pages.size %></p>
<%= link_to t('actions.select_pages'), select_pages_website_group_path(@group, website_id: @website.id), class: "btn btn-primary mb-3" %>

<%= render "websites/pages/list", pages: @root_pages if @root_pages.any? %>
