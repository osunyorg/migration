<%= simple_form_for(@group) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="form-inputs">
    <div class="row">
      <div class="col-md-6">
        <%= f.input :name %>
        <%= f.input :strategy_klass,
                    as: :select,
                    collection: @group.website.available_strategies %>
        <%= sanitize @group.strategy.hint if @group.strategy %>
      </div>
      <div class="col-md-6">
        <%= f.input :settings, input_html: { rows: 10 }, value: 'ok' %>
        <%= f.input :osuny_target_id %>
      </div>
    </div>
  </div>


  <div class="form-actions">
    <%= f.submit t('actions.save'), class: "btn btn-primary" %>
  </div>
<% end %>
