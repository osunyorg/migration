<div class="card">
  <div class="card-body">
    <h5 class="card-title"><%= link_to group, website_group_path(group, { website_id: group.website_id }) %></h5>
    <p><span class="badge bg-secondary"><%= group.strategy_klass.presence || "No strategy" %></span></p>
    <p><%= group.pages.root.size %> root pages (total: <%= group.pages.size %>)</p>
  </div>
</div>
