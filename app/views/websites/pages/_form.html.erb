<%= simple_form_for(@page) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="form-inputs">
    <%= f.input :title %>
    <%= f.input :url %>
    <%= f.association :language, collection: @website.languages %>
    <%= f.association :group, collection: @website.groups %>
    <%= f.association :parent, collection: @website.pages.where.not(id: @page.id) %>
  </div>

  <div class="form-actions">
    <%= f.submit t('actions.save'), class: "btn btn-primary" %>
  </div>
<% end %>
