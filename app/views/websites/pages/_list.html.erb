<table class="table table-striped" id="pages">
  <thead>
    <tr>
      <th>URL</th>
      <th>&nbsp;</th>
    </tr>
  </thead>
  <tbody>
    <% pages.each do |page| %>
      <tr>
        <td><%= link_to page, [page, website_id: page.website_id] %></td>
        <td>
          <%= link_to "View on website", page.url, target: :_blank, class: "btn btn-dark btn-sm" %>
          <%= link_to "Edit", [:edit, page, { website_id: page.website_id }], class: "btn btn-primary btn-sm" %>
          <%= link_to "Destroy", [page, { website_id: page.website_id }], method: :delete, class: "btn btn-danger btn-sm", data: { confirm: "Are you sure?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
