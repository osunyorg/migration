<% content_for :title, @page %>

<div class="mb-5">
  <% if @page.strategy %>
    <%= link_to t('actions.migrate_dry_run'), [:migrate, @page, { dry_run: true }], class: "btn btn-primary" %>
    <%= link_to t('actions.migrate'), [:migrate, @page], class: "btn btn-primary" %>
  <% end %>
  <%= link_to t('actions.edit'), [:edit, @page], class: "btn btn-primary" %>
  <%= link_to t('actions.delete'), @page, method: :delete, class: "btn btn-danger", data: { confirm: "Are you sure?" } %>
</div>

<div class="row">
  <div class="col-md-6">
    <p class="form-label"><%= Website::Page.human_attribute_name(:title) %></p>
    <p><%= @page.title %></p>
  </div>
  <div class="col-md-6">
    <p class="form-label"><%= Website::Page.human_attribute_name(:url) %></p>
    <p><%= link_to @page.url, @page.url, target: :_blank %></p>
  </div>
</div>

<div class="row">
  <div class="col-md-3">
    <p class="form-label"><%= Website::Page.human_attribute_name(:language) %></p>
    <p><%= @page.language %></p>
  </div>

  <div class="col-md-3">
    <p class="form-label"><%= Website::Page.human_attribute_name(:crawled_at) %></p>
    <p><%= l @page.crawled_at %></p>
  </div>

  <div class="col-md-3">
    <p class="form-label"><%= Website::Page.human_attribute_name(:group) %></p>
    <p><%= link_to @page.group, @page.group if @page.group %></p>
  </div>

  <div class="col-md-3">
    <p class="form-label"><%= Website::Page.human_attribute_name(:migrated_at) %></p>
    <p><%= l @page.migrated_at if @page.migrated_at %></p>
  </div>
</div>

<% if @page.parent %>
  <p class="form-label"><%= Website::Page.human_attribute_name(:parent) %></p>
  <p><%= link_to @page.parent, @page.parent %></p>
<% end %>

<% if @page.children.any? %>
  <p class="form-label"><%= Website::Page.human_attribute_name(:children) %></p>
  <ul class="list-unstyled">
    <% @page.children.each do |page| %>
      <li><%= link_to page, [page, website_id: page.website_id] %></li>
    <% end %>
  </ul>
<% end %>

<div class="card bg-light">
  <div class="card-body">
    <pre><%= @page.html %></pre>
  </div>
</div>
