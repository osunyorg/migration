<% content_for :title, @page %>

<p>
  <strong><%= Website::Page.human_attribute_name(:url) %></strong>
  <%= link_to @page.url, @page.url, target: :_blank %>
</p>

<p>
  <strong><%= Website::Page.human_attribute_name(:group) %></strong>
  <%= link_to @page.group, @page.group if @page.group %>
</p>

<p>
  <strong><%= Website::Page.human_attribute_name(:strategy) %></strong>
  <%= @page.strategy %>
</p>

<% if @page.parent %>
  <p>
    <strong>Parent:</strong>
    <%= link_to @page.parent, @page.parent %>
  </p>
<% end %>

<% if @page.children.any? %>
  <p><strong>Children</strong></p>
  <ul>
    <% @page.children.each do |page| %>
      <li><%= link_to page, [page, website_id: page.website_id] %></li>
    <% end %>
  </ul>
<% end %>

<div class="mb-5">
  <%= link_to t('actions.migrate'), [:migrate, @page], class: "btn btn-primary" if @page.strategy %>
  <%= link_to t('actions.edit'), [:edit, @page], class: "btn btn-primary" %>
  <%= link_to t('actions.delete'), @page, method: :delete, class: "btn btn-danger", data: { confirm: "Are you sure?" } %>
</div>

<div class="card bg-light">
  <div class="card-body">
    <pre><%= @page.html %></pre>
  </div>
</div>
