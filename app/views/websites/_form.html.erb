<%= simple_form_for(@website) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="form-inputs">
    <%= f.input :name %>
    <%= f.input :url %>
    <%= f.association :default_language, include_blank: false %>
    <%= f.association :languages, as: :check_boxes %>
    <%= f.input :osuny_host %>
    <%= f.input :osuny_api_key %>
    <%= f.input :osuny_website_id %>
  </div>

  <div class="form-actions">
    <%= f.submit t('actions.save'), class: "btn btn-primary" %>
  </div>
<% end %>
