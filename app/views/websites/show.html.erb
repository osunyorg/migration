<% content_for :title, @website %>

<h1><%= @website %></h1>

<p>
  <strong>URL: </strong>
  <%= @website.url %>
</p>

<p><strong>Languages</strong></p>
<ul>
  <% @website.languages.each do |language| %>
    <%= content_tag :li, language, class: (@website.default_language_id == language.id ? 'fw-bold' : nil) %>
  <% end %>
</ul>

<div class="mb-4">
  <%= link_to "Edit", [:edit, @website], class: "btn btn-primary" %>
  <%= link_to "Destroy", @website, method: :delete, class: "btn btn-danger", data: { confirm: "Are you sure?" } %>
</div>

<h2>Groups (<%= @groups.size %>)</h2>
<%= link_to "Create Group", new_website_group_path(website_id: @website.id), class: "btn btn-primary mb-3" %>

<%= render "websites/groups/list", groups: @groups if @groups.any? %>

<h2>Root pages (<%= @root_pages.size %>)</h2>

<p>Total: <%= @website.pages.size %></p>
<%= link_to "Create Page", new_website_page_path(website_id: @website.id), class: "btn btn-primary mb-3" %>

<%= render "websites/pages/list", pages: @root_pages if @root_pages.any? %>
