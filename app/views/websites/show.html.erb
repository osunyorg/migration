<% content_for :title, @website %>

<p>
  <strong><%= Website.human_attribute_name(:url) %></strong>
  <%= @website.url %>
</p>

<p><strong><%= Website::Language.model_name.human(count: 2) %></strong></p>
<ul class="list-unstyled">
  <% @website.languages.each do |language| %>
    <li>
      <%= language %>
      <% if @website.default_language_id == language.id %>
        <span class="badge bg-secondary text-dark">
        <%= Website.human_attribute_name(:default_language) %>
        </span>
      <% end %>
    </li>
  <% end %>
</ul>

<div class="mb-4">
  <%= link_to t('actions.crawl'), [:crawl, @website], class: "btn btn-primary" %>
  <%= link_to t('actions.edit'), [:edit, @website], class: "btn btn-primary" %>
  <%= link_to t('actions.delete'), @website, method: :delete, class: "btn btn-danger", data: { confirm: "Are you sure?" } %>
</div>

<h2><%= Website::Language.model_name.human(count: 2) %></h2>
<p><%= @languages.size %></p>
<%= link_to t('actions.create'), new_website_language_path(website_id: @website.id), class: "btn btn-primary mb-3" %>
<%= render "websites/languages/list", languages: @languages if @languages.any? %>

<h2><%= Website::Group.model_name.human(count: 2) %></h2>
<p><%= @groups.size %></p>
<%= link_to t('actions.create'), new_website_group_path(website_id: @website.id), class: "btn btn-primary mb-3" %>
<%= render "websites/groups/list", groups: @groups if @groups.any? %>

<h2><%= Website::Page.model_name.human(count: 2) %></h2>
<p><%= @website.pages.size %></p>
<%= link_to t('actions.create'), new_website_page_path(website_id: @website.id), class: "btn btn-primary mb-3" %>
<%= render "websites/pages/list", pages: @root_pages if @root_pages.any? %>
