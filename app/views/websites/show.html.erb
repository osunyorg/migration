<% content_for :title, @website %>

<h1><%= @website %></h1>

<p>
  <strong>URL: </strong>
  <%= @website.url %>
</p>

<p><strong>Languages</strong></p>
<ul>
  <% @website.languages.each do |language| %>
    <%= content_tag :li, language, class: (@website.default_language_id == language.id ? 'fw-bold' : nil) %>
  <% end %>
</ul>

<div class="mb-4">
  <%= link_to "Edit", [:edit, @website], class: "btn btn-primary" %>
  <%= link_to "Destroy", @website, method: :delete, class: "btn btn-danger", data: { confirm: "Are you sure?" } %>
</div>

<h2>Groups (<%= @groups.size %>)</h2>
<%= link_to "Create Group", new_website_group_path(website_id: @website.id), class: "btn btn-primary mb-3" %>

<% if @groups.any? %>
  <div class="row mb-4" id="groups">
    <% @groups.each do |group| %>
      <div class="col-lg-3">
        <%= render "websites/groups/group", group: group %>
      </div>
    <% end %>
    <div class="col-lg-3">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Pas de groupe</h5>

          <p><%= @website.pages.where(group_id: nil).size %> pages</p>
        </div>
      </div>
    </div>
  </div>
<% end %>

<h2>Pages (<%= @pages.size %>)</h2>
<%= link_to "Create Page", new_website_page_path(website_id: @website.id), class: "btn btn-primary mb-3" %>

<% if @pages.any? %>
  <table class="table table-striped" id="pages">
    <thead>
      <tr>
        <th>URL</th>
        <th>&nbsp;</th>
      </tr>
    </thead>
    <tbody>
      <% @pages.each do |page| %>
        <tr>
          <td><%= link_to page.url, website_page_path(page, { website_id: @website.id }) %></td>
          <td>
            <%= link_to "View on website", page.url, target: :_blank, class: "btn btn-dark btn-sm" %>
            <%= link_to "Edit", [:edit, page, { website_id: @website.id }], class: "btn btn-primary btn-sm" %>
            <%= link_to "Destroy", [page, { website_id: @website.id }], method: :delete, class: "btn btn-danger btn-sm", data: { confirm: "Are you sure?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
