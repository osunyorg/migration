<% content_for :title, "Websites" %>

<%= link_to "Create", new_website_path, class: "btn btn-primary mb-3" %>

<div clas="row" id="websites">
  <% @websites.each do |website| %>
    <div class="col-lg-3 col-md-4 mb-2">
      <div class="card">
        <div class="card-body">
          <h2><%= website %></h2>
          <p><%= link_to website.url, website.url, target: :_blank %></p>
          <%= link_to "View", website, class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
