<% content_for :title, @language %>

<p>
  <strong>Iso code: </strong>
  <%= @language.iso_code %>
</p>

<div>
  <%= link_to t('actions.edit'), [:edit, @language], class: "btn btn-primary" %>
  <%= link_to t('actions.delete'), @language, method: :delete, class: "btn btn-danger", data: { confirm: "Are you sure?" } %>
</div>
