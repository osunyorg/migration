<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} - Osuny Migrator" : "Osuny Migrator" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Osuny Migrator">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= favicon_link_tag 'favicon.png' %>
    <%= stylesheet_link_tag "application" %>
  </head>
  <body>
    <%= render 'header' %>
    <main>
      <div class="container-fluid mt-5">
        <h1><%= yield :title %></h1>
      </div>
      <% if breadcrumbs.any? %>
        <div class="mt-5 py-3 bg-light">
          <%= render_breadcrumbs builder: BreadcrumbsOnRailsBuilder %>
        </div>
      <% end %>
      <div class="container-fluid mt-5">
        <%= render 'notice' %>
        <%= yield %>
      </div>
    </main>
    <%= javascript_include_tag "application" %>
  </body>
</html>
